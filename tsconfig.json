{
    "extends": "@salesforce/dev-config/tsconfig-strict-esm",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "pretty": true,
        "declarationMap": true,
        "removeComments": true,
        "types": ["mocha", "node"]
    },
    "include": ["./src/**/*.ts"]
}
